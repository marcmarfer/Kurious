# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings > API. Without them the app still runs, just without login.
# For local development with `npm run db:start`, use the values that command prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: map style. Empty = OpenFreeMap until the own Kurious style is hosted.
NEXT_PUBLIC_MAP_STYLE_URL=

# Server secrets (Claude, Geoapify, payments) do NOT go here: they are Supabase
# function secrets, set with `npx supabase secrets set NAME=value`.
